{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "personal-blog",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-db",
      "database_id": "3f5f3a58-cf8b-4f21-a4a9-54b469e3c291"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "ce473681ded24830bf89a98676ee5ffd"
    }
  ]
}